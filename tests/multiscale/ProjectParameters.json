{
    "problem_data": {
        "problem_name": "Bending_beam",
        "model_part_name": "Structure",
        "domain_size": 3,
        "parallel_type": "OpenMP",
        "time_step": 0.10,
        "start_time": 0.0,
        "end_time": 1.0,
        "echo_level": 0
        },
    "solver_settings": {
        "solver_type": "Static",
        "echo_level": 0,
        "analysis_type": "non_linear",
        "model_import_settings": {
            "input_type": "mdpa",
            "input_filename": "macro"
            },
        "material_import_settings": {
            "materials_filename" : "materials.json"
            },
        "line_search": false,
        "convergence_criterion": "residual_criterion",
        "displacement_relative_tolerance": 1e-4,
        "displacement_absolute_tolerance": 1e-9,
        "residual_relative_tolerance": 1e-4,
        "residual_absolute_tolerance": 1e-9,
        "max_iteration": 10,
        "linear_solver_settings": {
            "solver_type": "SuperLUSolver",
            "scaling": false,
            "verbosity": 0
            },
        "problem_domain_sub_model_part_list": ["MACRO"],
        "processes_sub_model_part_list": ["PINNED", "LOAD", "MATERIAL_HOMOGENEOUS", "MATERIAL_MULTISCALE"],
        "rotation_dofs": false,
        "move_mesh_flag": false
        },
    "constraints_process_list": [{
        "python_module": "assign_vector_variable_process",
        "kratos_module": "KratosMultiphysics",
        "process_name": "AssignVectorVariableProcess",
        "Parameters": {
            "model_part_name": "PINNED",
            "variable_name": "DISPLACEMENT",
            "constrained": [true, true, true],
            "value": [0.0, 0.0, 0.0],
	    "interval": [0.0, "End"]
            }
        }],
    "loads_process_list"       : [{
        "python_module" : "assign_vector_by_direction_to_condition_process",
        "kratos_module" : "KratosMultiphysics",
        "help"          : "This process sets a vector variable value over a condition",
        "check"         : "DirectorVectorNonZero direction",
        "process_name"  : "AssignModulusAndDirectionToConditionsProcess",
        "Parameters"            : {
            "model_part_name" : "LOAD",
            "variable_name"   : "POINT_LOAD",
            "modulus"          : 1,
            "direction"       : [0, -1, 0],
            "interval"        : [0.0, "End"]
        }
    }],
    "output_configuration"     : {
        "result_file_configuration" : {
            "gidpost_flags"       : {
                "GiDPostMode"           : "GiD_PostAscii",
                "WriteDeformedMeshFlag" : "WriteDeformed",
                "WriteConditionsFlag"   : "WriteConditions",
                "MultiFileFlag"         : "SingleFile"
                },
            "file_label"          : "step",
            "output_control_type" : "time",
            "output_frequency"    : 1,
            "body_output"         : true,
            "node_output"         : true,
            "skin_output"         : false,
            "plane_output"        : [],
            "nodal_results"       : ["DISPLACEMENT", "REACTION", "POINT_LOAD"],
            "gauss_point_results" : ["GREEN_LAGRANGE_STRAIN_TENSOR", "CAUCHY_STRESS_TENSOR"]
            },
        "point_data_configuration"  : []
        },
    "restart_options"          : {
        "SaveRestart"      : false,
        "RestartFrequency" : 0,
        "LoadRestart"      : false,
        "Restart_Step"     : 0
    },
    "constraints_data"         : {
        "incremental_load"         : false,
        "incremental_displacement" : false
    }
}
